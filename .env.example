# Juris AI RAG Service — Environment Configuration (.env.example)

# Runtime environment: 'dev' or 'production' (default: dev)
ENV=dev

# Shared API key required in X-API-Key header on all endpoints except GET /health.
# If ENV=dev and unset, defaults to 'dev-rag-key'.
# If ENV=production and unset, the service refuses to start.
RAG_API_KEY=dev-rag-key

# Anthropic API key for Claude models.
# When unset, MOCK_LLM automatically defaults to 1 (deterministic mock mode).
ANTHROPIC_API_KEY=

# Anthropic model identifiers for main analysis/memo and small query-planning/selection tasks
MODEL_MAIN=claude-sonnet-5-5
MODEL_SMALL=claude-haiku-5-5

# Force deterministic mock mode (1 = force mock; 0 = use real Anthropic API when ANTHROPIC_API_KEY is set)
MOCK_LLM=1

# Optional OpenAI API key (used when EMBEDDINGS_BACKEND=openai for text-embedding-3-small)
OPENAI_API_KEY=

# Embeddings backend: 'openai' | 'local' | 'hash'
# Defaults to 'openai' if OPENAI_API_KEY is set, otherwise 'hash' (deterministic 384-dim hashing embedder).
EMBEDDINGS_BACKEND=hash

# Maximum allowed characters in POST /analyze document_text (requests above this return HTTP 413)
MAX_DOC_CHARS=150000

# Comma-separated list of allowed CORS origins (default: empty)
CORS_ORIGINS=
